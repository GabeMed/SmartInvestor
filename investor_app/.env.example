# Copy to investor_app/.env. Everything is optional for local development.

# https://brapi.dev token. PETR4, VALE3, MGLU3, ITUB4 and the quote list work without one.
BRAPI_KEY=your_brapi_token

# Recipient of the price alerts.
EMAIL_TEST=alerts@example.com

# SMTP (e.g. a Gmail app password). Without these, e-mails go to the console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=example@email.com
# EMAIL_HOST_PASSWORD=app-password

# SECRET_KEY=change-me
# DEBUG=true
# ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://user:pass@localhost:5432/smart_investor
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
